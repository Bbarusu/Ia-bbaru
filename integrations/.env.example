# Reference only: the gateway does NOT load .env files. Export in your shell.
# Generate your own token and use the same value in the backend's GATEWAY_TOKEN.
GATEWAY_TOKEN=replace-with-a-random-token-at-least-32-characters
IA_BBARU_GATEWAY_DB=data/integrations.sqlite3
# Models you choose for the Claude Code connection (comma separated).
IA_BBARU_CLAUDE_CODE_MODELS=sonnet
# IA_BBARU_CLAUDE_CODE_BIN=C:\path\to\claude.exe
# IA_BBARU_CLAUDE_CODE_TIMEOUT_S=90
# IA_BBARU_CLAUDE_CODE_MAX_OUTPUT_TOKENS=4096
# IA_BBARU_CLAUDE_CODE_CONTEXT_CHARS=80000
# Only after reading integrations/README.md, "Limite de saída":
# IA_BBARU_CLAUDE_CODE_ACCEPT_UNENFORCED_OUTPUT_LIMIT=1
# Never put ANTHROPIC_API_KEY here: it would switch Claude Code to API billing
# (the gateway strips it from the child process anyway).
