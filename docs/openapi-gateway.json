{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Gateway contract (not an implementation)",
    "version": "1"
  },
  "paths": {
    "/v1/models": {
      "get": {
        "summary": "Models",
        "operationId": "models_v1_models_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelCatalog"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/generate": {
      "post": {
        "summary": "Generate",
        "operationId": "generate_v1_generate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ContextItem": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "content": {
            "type": "string",
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title",
          "content"
        ],
        "title": "ContextItem"
      },
      "GenerateRequest": {
        "properties": {
          "protocol_version": {
            "type": "string",
            "const": "1",
            "title": "Protocol Version",
            "default": "1"
          },
          "request_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Request Id"
          },
          "model_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Model Id"
          },
          "role": {
            "type": "string",
            "enum": [
              "answer",
              "review"
            ],
            "title": "Role"
          },
          "instruction": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Instruction"
          },
          "context": {
            "items": {
              "$ref": "#/components/schemas/ContextItem"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Context"
          },
          "previous_output": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100000
              },
              {
                "type": "null"
              }
            ],
            "title": "Previous Output"
          },
          "max_output_tokens": {
            "type": "integer",
            "maximum": 4096.0,
            "minimum": 1.0,
            "title": "Max Output Tokens"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "model_id",
          "role",
          "instruction",
          "context",
          "max_output_tokens"
        ],
        "title": "GenerateRequest"
      },
      "GenerateResponse": {
        "properties": {
          "protocol_version": {
            "type": "string",
            "const": "1",
            "title": "Protocol Version",
            "default": "1"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "model_id": {
            "type": "string",
            "title": "Model Id"
          },
          "output": {
            "type": "string",
            "maxLength": 100000,
            "minLength": 1,
            "title": "Output"
          },
          "usage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TokenUsage"
              },
              {
                "type": "null"
              }
            ]
          },
          "provider_request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider Request Id"
          },
          "finish_reason": {
            "type": "string",
            "enum": [
              "stop",
              "length"
            ],
            "title": "Finish Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "model_id",
          "output",
          "finish_reason"
        ],
        "title": "GenerateResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ModelCatalog": {
        "properties": {
          "protocol_version": {
            "type": "string",
            "const": "1",
            "title": "Protocol Version",
            "default": "1"
          },
          "models": {
            "items": {
              "$ref": "#/components/schemas/ModelProfile"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Models"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "models"
        ],
        "title": "ModelCatalog"
      },
      "ModelProfile": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Id"
          },
          "provider": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Provider"
          },
          "label": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Label"
          },
          "available": {
            "type": "boolean",
            "title": "Available"
          },
          "task_kinds": {
            "items": {
              "type": "string",
              "enum": [
                "general",
                "study",
                "writing",
                "coding",
                "analysis"
              ]
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 1,
            "title": "Task Kinds"
          },
          "context_char_limit": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 1000.0,
            "title": "Context Char Limit"
          },
          "max_output_tokens": {
            "type": "integer",
            "maximum": 32768.0,
            "minimum": 1.0,
            "title": "Max Output Tokens"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "provider",
          "label",
          "available",
          "task_kinds",
          "context_char_limit",
          "max_output_tokens"
        ],
        "title": "ModelProfile"
      },
      "TokenUsage": {
        "properties": {
          "input_tokens": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Input Tokens"
          },
          "output_tokens": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Output Tokens"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "input_tokens",
          "output_tokens"
        ],
        "title": "TokenUsage"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
