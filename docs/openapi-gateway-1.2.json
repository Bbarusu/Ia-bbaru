{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Gateway contract 1.2",
    "version": "1.2"
  },
  "paths": {
    "/v1.2/models": {
      "get": {
        "summary": "Models",
        "operationId": "models_v1_2_models_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelCatalogV12"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1.2/generate": {
      "post": {
        "summary": "Generate",
        "operationId": "generate_v1_2_generate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateRequestV12"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerateResponseV12"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AttachmentReceipt": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "title": "Id"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Sha256"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "sha256"
        ],
        "title": "AttachmentReceipt"
      },
      "ContextItem": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "content": {
            "type": "string",
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title",
          "content"
        ],
        "title": "ContextItem"
      },
      "GenerateRequestV12": {
        "properties": {
          "protocol_version": {
            "type": "string",
            "const": "1.2",
            "title": "Protocol Version"
          },
          "request_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Request Id"
          },
          "model_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Model Id"
          },
          "role": {
            "type": "string",
            "enum": [
              "answer",
              "review"
            ],
            "title": "Role"
          },
          "instruction": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Instruction"
          },
          "context": {
            "items": {
              "$ref": "#/components/schemas/ContextItem"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Context"
          },
          "previous_output": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100000
              },
              {
                "type": "null"
              }
            ],
            "title": "Previous Output"
          },
          "max_output_tokens": {
            "type": "integer",
            "maximum": 4096.0,
            "minimum": 1.0,
            "title": "Max Output Tokens"
          },
          "allow_unenforced_output_limit": {
            "type": "boolean",
            "title": "Allow Unenforced Output Limit",
            "default": false
          },
          "attachments": {
            "items": {
              "$ref": "#/components/schemas/VisualAttachment"
            },
            "type": "array",
            "maxItems": 1,
            "title": "Attachments"
          },
          "allow_visual_input": {
            "type": "boolean",
            "title": "Allow Visual Input",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "protocol_version",
          "request_id",
          "model_id",
          "role",
          "instruction",
          "context",
          "max_output_tokens"
        ],
        "title": "GenerateRequestV12"
      },
      "GenerateResponseV12": {
        "properties": {
          "protocol_version": {
            "type": "string",
            "const": "1.2",
            "title": "Protocol Version",
            "default": "1.2"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "model_id": {
            "type": "string",
            "title": "Model Id"
          },
          "output": {
            "type": "string",
            "maxLength": 100000,
            "minLength": 1,
            "title": "Output"
          },
          "usage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TokenUsage"
              },
              {
                "type": "null"
              }
            ]
          },
          "provider_request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider Request Id"
          },
          "finish_reason": {
            "type": "string",
            "enum": [
              "stop",
              "length",
              "unknown"
            ],
            "title": "Finish Reason"
          },
          "served_model": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "minLength": 1,
                "pattern": "^claude-[A-Za-z0-9.\\[\\]-]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Served Model"
          },
          "attachments_used": {
            "items": {
              "$ref": "#/components/schemas/AttachmentReceipt"
            },
            "type": "array",
            "maxItems": 1,
            "title": "Attachments Used"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "model_id",
          "output",
          "finish_reason"
        ],
        "title": "GenerateResponseV12"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImageCapability": {
        "properties": {
          "supported": {
            "type": "boolean",
            "title": "Supported",
            "default": false
          },
          "mime_types": {
            "items": {
              "type": "string",
              "enum": [
                "image/png",
                "image/jpeg"
              ]
            },
            "type": "array",
            "title": "Mime Types"
          },
          "max_images": {
            "type": "integer",
            "const": 1,
            "title": "Max Images",
            "default": 1
          },
          "max_bytes_per_image": {
            "type": "integer",
            "const": 480000,
            "title": "Max Bytes Per Image",
            "default": 480000
          },
          "max_pixels": {
            "type": "integer",
            "const": 16000000,
            "title": "Max Pixels",
            "default": 16000000
          },
          "transport": {
            "type": "string",
            "const": "cli_stream_input",
            "title": "Transport",
            "default": "cli_stream_input"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ImageCapability"
      },
      "InputCapabilities": {
        "properties": {
          "image": {
            "$ref": "#/components/schemas/ImageCapability"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "InputCapabilities"
      },
      "ModelCapabilities": {
        "properties": {
          "output_limit": {
            "type": "string",
            "enum": [
              "enforced",
              "best_effort",
              "none"
            ],
            "title": "Output Limit"
          },
          "cancellation": {
            "type": "string",
            "enum": [
              "provider",
              "local_process_only",
              "none"
            ],
            "title": "Cancellation"
          },
          "finish_reason": {
            "type": "string",
            "enum": [
              "reported",
              "inferred"
            ],
            "title": "Finish Reason"
          },
          "billing": {
            "type": "string",
            "enum": [
              "api_key",
              "subscription_quota",
              "unknown"
            ],
            "title": "Billing"
          },
          "streaming": {
            "type": "boolean",
            "title": "Streaming"
          },
          "tools": {
            "type": "string",
            "enum": [
              "disabled",
              "restricted"
            ],
            "title": "Tools"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "output_limit",
          "cancellation",
          "finish_reason",
          "billing",
          "streaming",
          "tools"
        ],
        "title": "ModelCapabilities"
      },
      "ModelCatalogV12": {
        "properties": {
          "protocol_version": {
            "type": "string",
            "const": "1.2",
            "title": "Protocol Version",
            "default": "1.2"
          },
          "models": {
            "items": {
              "$ref": "#/components/schemas/ModelProfileV12"
            },
            "type": "array",
            "title": "Models"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "models"
        ],
        "title": "ModelCatalogV12"
      },
      "ModelProfileV12": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Id"
          },
          "provider": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Provider"
          },
          "label": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Label"
          },
          "available": {
            "type": "boolean",
            "title": "Available"
          },
          "task_kinds": {
            "items": {
              "type": "string",
              "enum": [
                "general",
                "study",
                "writing",
                "coding",
                "analysis"
              ]
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 1,
            "title": "Task Kinds"
          },
          "context_char_limit": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 1000.0,
            "title": "Context Char Limit"
          },
          "max_output_tokens": {
            "type": "integer",
            "maximum": 32768.0,
            "minimum": 1.0,
            "title": "Max Output Tokens"
          },
          "capabilities": {
            "$ref": "#/components/schemas/ModelCapabilities"
          },
          "unavailable_reason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ],
            "title": "Unavailable Reason"
          },
          "input": {
            "$ref": "#/components/schemas/InputCapabilities"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "provider",
          "label",
          "available",
          "task_kinds",
          "context_char_limit",
          "max_output_tokens",
          "capabilities"
        ],
        "title": "ModelProfileV12"
      },
      "TokenUsage": {
        "properties": {
          "input_tokens": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Input Tokens"
          },
          "output_tokens": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Output Tokens"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "input_tokens",
          "output_tokens"
        ],
        "title": "TokenUsage"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VisualAttachment": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "title": "Id"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Sha256"
          },
          "project_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "title": "Project Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "image",
              "screenshot"
            ],
            "title": "Kind"
          },
          "mime_type": {
            "type": "string",
            "enum": [
              "image/png",
              "image/jpeg"
            ],
            "title": "Mime Type"
          },
          "byte_count": {
            "type": "integer",
            "maximum": 480000.0,
            "minimum": 1.0,
            "title": "Byte Count"
          },
          "width": {
            "type": "integer",
            "maximum": 8000.0,
            "minimum": 1.0,
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "maximum": 8000.0,
            "minimum": 1.0,
            "title": "Height"
          },
          "data_base64": {
            "type": "string",
            "maxLength": 640000,
            "minLength": 1,
            "title": "Data Base64"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "sha256",
          "project_id",
          "kind",
          "mime_type",
          "byte_count",
          "width",
          "height",
          "data_base64"
        ],
        "title": "VisualAttachment"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
