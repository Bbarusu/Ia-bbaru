{
  "manifest_version": 3,
  "name": "Ia-bbaru",
  "version": "0.1.0",
  "description": "Projetos, contexto selecionado e agentes de IA no seu Firefox.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ia-bbaru@bbarusu.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "nativeMessaging"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Abrir Ia-bbaru",
    "default_icon": "icons/mark.svg"
  },
  "icons": {
    "48": "icons/mark.svg",
    "96": "icons/mark.svg"
  },
  "sidebar_action": {
    "default_title": "Ia-bbaru",
    "default_panel": "app/index.html",
    "default_icon": "icons/mark.svg"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self'"
  }
}
