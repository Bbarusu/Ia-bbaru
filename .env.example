# Export these variables in the shell. This application does not load .env files.
# Generate your own token; do not use this example value.
LAUNCHER_API_TOKEN=replace-with-a-random-token-at-least-32-characters
LAUNCHER_DB_PATH=data/launcher.sqlite3
# Claude's separate local gateway; use an independent service token.
# GATEWAY_URL=http://127.0.0.1:8010
# GATEWAY_TOKEN=another-independent-random-token
# Defaults to 1. Set 1.1 explicitly to use the capabilities contract; no fallback.
# GATEWAY_PROTOCOL_VERSION=1.1
